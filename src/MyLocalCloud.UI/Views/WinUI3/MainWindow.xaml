<Window
    x:Class="MyLocalCloud.UI.Views.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="myLocalCloud v1.1 - Panel de Control Multicloud (Paleta Celeste y Gris)">

    <!-- Plantilla declarativa WinUI 3 (MVVM) con Paleta Primaria Celeste (#0EA5E9 / #38BDF8) y Gris (#475569 / #E2E8F0) -->
    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" Background="#E2E8F0">
        <!-- Encabezado Gris Pizarra con acento Celeste y Logo Árbol-Nube -->
        <Border Grid.Row="0" Background="#475569" CornerRadius="10" Padding="18">
            <StackPanel Spacing="6">
                <TextBlock Text="🌳☁ myLocalCloud v1.1 — Unidades de Disco Virtuales Multicloud (Files On-Demand)"
                           FontSize="22" FontWeight="SemiBold" Foreground="#E0F2FE" />
                <TextBlock Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}"
                           FontSize="14" Foreground="#38BDF8" />
            </StackPanel>
        </Border>

        <!-- Acciones Rápidas de Sincronización Periódica en Celeste y Gris -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,16">
            <Button Content="Sincronizar ahora" Background="#0EA5E9" Foreground="White" Command="{x:Bind ViewModel.SyncNowCommand}" />
            <Button Content="Pausar / Reanudar Sincronización" Background="#64748B" Foreground="White" Command="{x:Bind ViewModel.TogglePauseResumeSyncCommand}" />
        </StackPanel>

        <!-- Lista de Usuarios Multicloud y Letras de Unidad Virtual (Google Drive, OneDrive, Dropbox, FTP, MEGA) -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ConnectedAccounts, Mode=OneWay}" Background="#F8FAFC">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Border Background="#E0F2FE" CornerRadius="6" Padding="10,6" Margin="0,0,14,0">
                            <TextBlock Text="{Binding VirtualDriveLetter}" FontWeight="Bold" FontSize="16" Foreground="#0284C7" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#1E293B" />
                            <TextBlock Text="{Binding AccountEmailOrUser}" Foreground="#475569" />
                            <TextBlock Text="{Binding DeliveryModeDescription}" Foreground="#0284C7" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding LastSyncText}" VerticalAlignment="Center" Foreground="#0284C7" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Pie de Versión 1.1 y Autoría Oficial -->
        <Border Grid.Row="3" Padding="12" CornerRadius="8" Background="#475569" Margin="0,16,0,0">
            <TextBlock Text="Versión 1.1 — Desarrollada por android.ar | Desarrollador: Alejandro Ferrer"
                       Foreground="#38BDF8" HorizontalAlignment="Center" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
