<Window
    x:Class="MyLocalCloud.UI.Views.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="myLocalCloud - Panel de Control Multicloud (v1.0)">

    <!-- Plantilla declarativa WinUI 3 (MVVM) para el Panel de Control de myLocalCloud -->
    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" Background="#0F172A">
        <!-- Encabezado y Estado de Sincronización en Vivo -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="myLocalCloud — Virtual File System (Files On-Demand)"
                       FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC" />
            <TextBlock Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}"
                       FontSize="14" Foreground="#38BDF8" />
        </StackPanel>

        <!-- Acciones Rápidas de Sincronización Periódica -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,16">
            <Button Content="Sincronizar ahora" Command="{x:Bind ViewModel.SyncNowCommand}" />
            <Button Content="Pausar / Reanudar Sincronización" Command="{x:Bind ViewModel.TogglePauseResumeSyncCommand}" />
        </StackPanel>

        <!-- Lista de Cuentas Multicloud Cifradas (Google Drive, OneDrive, Dropbox, FTP, MEGA) -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ConnectedAccounts, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="{Binding AccountEmailOrUser}" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding LocalSyncRootPath}" Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding LastSyncText}" VerticalAlignment="Center" Foreground="#22C55E" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Pie de Versión y Autoría Oficial -->
        <Border Grid.Row="3" Padding="12" CornerRadius="8" Background="#1E293B" Margin="0,16,0,0">
            <TextBlock Text="Versión 1.0 — Desarrollada por android.ar | Desarrollador: Alejandro Ferrer"
                       Foreground="#E2E8F0" HorizontalAlignment="Center" FontWeight="Medium" />
        </Border>
    </Grid>
</Window>
